---
import BaseLayout from '../layouts/BaseLayout.astro';
import IconSprite from '../components/IconSprite.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import IntroAndLiveSections from '../components/IntroAndLiveSections.astro';
import NotesEducation from '../components/NotesEducation.astro';
import Experience from '../components/Experience.astro';
import RightSidebar from '../components/RightSidebar.astro';
import Overlays from '../components/Overlays.astro';
---

<BaseLayout
  title="Elijah Melton | Software Engineer"
  description="Elijah Melton - Software Engineer specializing in distributed systems, backend development, and cloud infrastructure"
>
  <IconSprite />
  <div class="site-container">
    <LeftSidebar />
    <main class="main-content">
      <IntroAndLiveSections />
      <NotesEducation />
      <Experience />
    </main>
    <RightSidebar />
  </div>
  <Overlays />

  <script>
    import '../../js/canvas.ts';
    import '../../js/click-tracking.ts';
    import '../../js/main.ts';
  </script>
</BaseLayout>

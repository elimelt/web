---
import ChordBrowser from '../components/music/ChordBrowser.astro';
import ChordDisplay from '../components/music/ChordDisplay.astro';
import HistoryModal from '../components/music/HistoryModal.astro';
import PianoKeyboard from '../components/music/PianoKeyboard.astro';
import Transport from '../components/music/Transport.astro';
import '../../music/styles.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Voice Leading Synth | Elijah Melton</title>
    <meta name="description" content="An interactive browser synthesizer for exploring chord voicings, progressions, and smooth voice leading." />
    <link rel="canonical" href="https://elimelt.com/music/" />
    <meta property="og:site_name" content="Elijah Melton" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Voice Leading Synth | Elijah Melton" />
    <meta property="og:description" content="An interactive browser synthesizer for exploring chord voicings, progressions, and smooth voice leading." />
    <meta property="og:url" content="https://elimelt.com/music/" />
    <meta property="og:image" content="https://elimelt.com/assets/apple-touch.png" />
    <meta property="og:image:alt" content="Blue three-dimensional letter E logo" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Voice Leading Synth | Elijah Melton" />
    <meta name="twitter:description" content="An interactive browser synthesizer for exploring chord voicings, progressions, and smooth voice leading." />
    <meta name="twitter:image" content="https://elimelt.com/assets/apple-touch.png" />
    <link rel="icon" type="image/png" href="/assets/apple-touch.png" />
  </head>
  <body>
    <div class="app">
      <Transport />
      <ChordDisplay />
      <PianoKeyboard />
      <ChordBrowser />
    </div>

    <HistoryModal />
    <script src="../../music/main.ts"></script>
  </body>
</html>

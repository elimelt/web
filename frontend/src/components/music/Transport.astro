<div class="transport">
  <div class="transport-section">
    <button id="start-btn" title="Play/Stop (Space)">▶</button>
  </div>
  <div class="transport-section">
    <button id="bass-toggle" class="toggle-btn" title="Toggle bass">Bass</button>
  </div>
  <div class="transport-section">
    <span class="param-label">Voice</span>
    <button id="inversion-down" class="mini-btn" title="Voice down">◁</button>
    <button id="inversion-up" class="mini-btn" title="Voice up">▷</button>
  </div>
  <div class="transport-section">
    <span class="param-label">8va</span>
    <button id="octave-down" class="mini-btn" title="Octave down">−</button>
    <button id="octave-up" class="mini-btn" title="Octave up">+</button>
  </div>
  <div class="transport-section">
    <select id="transpose-select" title="Transpose">
      <option value="0">C (Concert)</option>
      <option value="2">B♭</option>
      <option value="9">E♭</option>
      <option value="7">F</option>
    </select>
  </div>
  <div class="transport-section grow">
    <div class="mixer">
      <div class="mixer-ch">
        <label for="vol-chord">Ch</label>
        <input type="range" id="vol-chord" min="0" max="100" value="70" />
      </div>
      <div class="mixer-ch">
        <label for="vol-bass">Bs</label>
        <input type="range" id="vol-bass" min="0" max="100" value="75" />
      </div>
      <div class="mixer-ch">
        <label for="vol-piano">Pn</label>
        <input type="range" id="vol-piano" min="0" max="100" value="70" />
      </div>
    </div>
  </div>
</div>

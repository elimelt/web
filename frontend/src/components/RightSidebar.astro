---
const photos = ['IMG_8179.jpg', 'IMG_8228.jpg', 'IMG_8322.jpg', 'IMG_8653.jpg', 'IMG_8762.jpg', 'IMG_8783.jpg', 'IMG_8784.jpg'];
const livePhotos = ['IMG_8875', 'IMG_8913'];
---

<button id="right-menu-toggle" class="right-menu-toggle" data-analytics="button" data-analytics-id="btn:right-menu-toggle" data-analytics-label="Right menu toggle" aria-label="Toggle photo sidebar">
  <svg class="menu-icon" id="right-menu-icon"><use href="#icon-chevron-left"></use></svg>
</button>

<aside class="right-sidebar" id="right-sidebar" inert>
  <template id="photo-gallery-template">
    <div class="photo-grid">
      {photos.map((photo) => <figure class="photo-item"><img src={`/assets/album/thumbs/${photo.replace('.jpg', '.webp')}`} alt="" width="640" height="640" loading="lazy" decoding="async" /></figure>)}
      {livePhotos.map((photo) => (
        <figure class="photo-item live-photo" data-photo={photo} tabindex="0" role="button" aria-label="Play Live Photo">
          <img src={`/assets/album/thumbs/${photo}.webp`} alt="" width="640" height="640" loading="lazy" decoding="async" />
        </figure>
      ))}
    </div>
  </template>
</aside>
<div class="sidebar-resize-handle" id="left-resize-handle"></div>
<div class="sidebar-resize-handle" id="right-resize-handle"></div>

<script>
  const sidebar = document.getElementById('right-sidebar');
  const template = document.getElementById('photo-gallery-template') as HTMLTemplateElement;
  // Offscreen drawers are within browsers' lazy-load margins. Keep their image
  // URLs inert until the drawer is actually opened (including wide desktops).
  const hydrate = () => {
    if (!sidebar) return;
    const open = sidebar.classList.contains('mobile-open');
    sidebar.inert = !open;
    if (!open || !template.isConnected) return;
    sidebar.append(template.content.cloneNode(true));
    template.remove();
    sidebar.querySelectorAll<HTMLElement>('.live-photo').forEach(setupLivePhoto);
  };
  const observer = new MutationObserver(hydrate);
  if (sidebar && template) {
    observer.observe(sidebar, { attributes: true, attributeFilter: ['class'] });
    hydrate();
  }

  interface LivePlayer extends HTMLElement {
    photoSrc: string;
    videoSrc: string;
    showsNativeControls: boolean;
    play(): void;
    pause(): void;
    stop(): void;
  }
  let kit: Promise<void> | undefined;
  const loadKit = () => kit ??= new Promise<void>((resolve, reject) => {
    const script = document.createElement('script');
    script.src = 'https://cdn.apple-livephotoskit.com/lpk/1/livephotoskit.js';
    script.onload = () => resolve();
    script.onerror = () => { script.remove(); kit = undefined; reject(new Error('Live Photo player unavailable')); };
    document.head.append(script);
  });
  function setupLivePhoto(figure: HTMLElement) {
    let player: LivePlayer | undefined;
    let loading: Promise<void> | undefined;
    let active = false;

    const reset = () => {
      player?.pause();
      player?.remove();
      player = undefined;
      figure.removeAttribute('aria-busy');
    };
    const start = async () => {
      active = true;
      if (player) { player.play(); return; }
      if (loading) return;
      figure.setAttribute('aria-busy', 'true');
      loading = (async () => {
        try {
          await loadKit();
          // A quick pass over the photo must not start playback later.
          if (!active) return;
          const element = document.createElement('div');
          element.className = 'live-photo-player';
          const api = (window as unknown as { LivePhotosKit: { Player(el: HTMLElement): LivePlayer } }).LivePhotosKit;
          player = api.Player(element);
          player.showsNativeControls = false;
          player.addEventListener('photoload', () => element.classList.add('is-ready'), { once: true });
          player.addEventListener('error', reset, { once: true });
          player.photoSrc = `/assets/album/${figure.dataset.photo}.jpg`;
          player.videoSrc = `/assets/album/${figure.dataset.photo}.MOV`;
          figure.append(player);
          player.play();
        } catch {
          reset();
        } finally {
          loading = undefined;
          figure.removeAttribute('aria-busy');
        }
      })();
      await loading;
    };
    const stop = () => {
      active = false;
      // pause clears pending playback even if the video is still loading.
      player?.pause();
      player?.stop();
    };
    figure.addEventListener('pointerenter', event => {
      if (event.pointerType !== 'touch') void start();
    });
    figure.addEventListener('pointerleave', event => {
      if (event.pointerType !== 'touch') stop();
    });
    figure.addEventListener('focus', () => {
      if (figure.matches(':focus-visible')) void start();
    });
    figure.addEventListener('blur', stop);
    figure.addEventListener('click', () => void start());
    figure.addEventListener('keydown', event => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      void start();
    });
  }
</script>

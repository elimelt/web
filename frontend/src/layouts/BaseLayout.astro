---
import '../../css/base/variables.css';
import '../../css/base/reset.css';
import '../../css/layout/sidebar.css';
import '../../css/layout/grid.css';
import '../../css/components/timeline.css';
import '../../css/components/notes.css';
import '../../css/components/buttons.css';
import '../../css/components/chat.css';
import '../../css/components/visitors.css';
import '../../css/features/meat-game.css';
import '../../css/features/dice-game.css';
import '../../css/responsive.css';
import '../../css/layout/editorial.css';
import '../../css/components/visitor-map.css';
import '../../css/canvas.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL('/assets/apple-touch.png', Astro.site);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Elijah Melton',
  url: new URL('/', Astro.site).href,
  jobTitle: 'Software Engineer',
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'University of Washington',
  },
  sameAs: [
    'https://github.com/elimelt',
    'https://linkedin.com/in/elimelt',
    'https://notes.elimelt.com',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Elijah Melton" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="Elijah Melton" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Blue three-dimensional letter E logo" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Crimson+Pro:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/assets/apple-touch.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch.png" />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <slot />

    <script is:inline src="https://cdn.apple-livephotoskit.com/lpk/1/livephotoskit.js"></script>
  </body>
</html>

{
  "name": "elimelt",
  "version": "0.1.0",
  "description": "TypeScript client SDK for the elimelt.com API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "elimelt",
    "api",
    "sdk",
    "client",
    "typescript",
    "websocket",
    "chat",
    "analytics"
  ],
  "author": "Eli Melt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/elimelt/web"
  },
  "homepage": "https://elimelt.com",
  "bugs": {
    "url": "https://github.com/elimelt/web/issues"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}

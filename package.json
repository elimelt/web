{
  "dependencies": {
    "@augmentcode/auggie": "^0.28.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.58.2",
    "@types/leaflet": "1.9",
    "@types/node": "^22.20.2",
    "@types/three": "^0.160.0",
    "@types/ws": "^8.18.1",
    "astro": "^7.3.5",
    "dompurify": "^3.4.15",
    "html2canvas": "^1.4.1",
    "maplibre-gl": "^6.4.1",
    "marked": "^15.0.0",
    "three": "^0.160.0",
    "tone": "^14.8.49",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vexflow": "^4.2.3"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "astro check --minimumSeverity warning && tsc --noEmit && tsc -p tests/tsconfig.json && tsc -p scripts/tsconfig.json",
    "test": "npm run typecheck && npm run build && npm run test:unit",
    "dev": "astro dev",
    "test:unit": "node --import tsx --test scripts/build.test.ts",
    "test:browser": "playwright test",
    "preview": "astro preview"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }

# Homelab Caddy Configuration
# ============================
# Cloudflare Tunnel terminates TLS and sends HTTP to Caddy.
# Add new services by adding a @servicename matcher and handle block.
#
# Reload: docker exec caddy caddy reload --config /etc/caddy/Caddyfile
{
	auto_https off
	order rate_limit before basicauth
	servers {
		# Trust cloudflared (Docker network) so the real client IP from
		# X-Forwarded-For is preserved and passed to upstream services.
		trusted_proxies static private_ranges
	}
}

# Global rate limit configuration
(rate_limit_transcribe) {
	rate_limit {
		zone transcribe_zone {
			key {http.request.header.CF-Connecting-IP}
			events 10
			window 1m
		}
	}
}

(rate_limit_llm) {
	rate_limit {
		zone llm_zone {
			key {http.request.header.CF-Connecting-IP}
			events 20
			window 1m
		}
	}
}

# CORS for *.elimelt.com, tech.sex, and localhost development
(cors_elimelt) {
	@cors_preflight method OPTIONS
	handle @cors_preflight {
		@cors_allowed_preflight {
			expression {http.request.header.Origin}.matches("^https://[a-zA-Z0-9-]+\\.elimelt\\.com$") || {http.request.header.Origin} == "https://tech.sex" || {http.request.header.Origin} == "https://www.tech.sex" || {http.request.header.Origin} == "http://localhost:5173"
		}
		header @cors_allowed_preflight Access-Control-Allow-Origin "{http.request.header.Origin}"
		header @cors_allowed_preflight Access-Control-Allow-Methods "GET, POST, OPTIONS"
		header @cors_allowed_preflight Access-Control-Allow-Headers "Content-Type, Authorization"
		header @cors_allowed_preflight Access-Control-Max-Age "86400"
		respond @cors_allowed_preflight 204
		respond "Forbidden" 403
	}

	@cors_allowed {
		expression {http.request.header.Origin}.matches("^https://[a-zA-Z0-9-]+\\.elimelt\\.com$") || {http.request.header.Origin} == "https://tech.sex" || {http.request.header.Origin} == "https://www.tech.sex" || {http.request.header.Origin} == "http://localhost:5173"
	}
	header @cors_allowed Access-Control-Allow-Origin "{http.request.header.Origin}"
}

# Static sites published by infra/sites/publish.sh into /srv/sites/<site>/current.
# Pretty URLs resolve like GitHub Pages: /foo serves foo.html, directories get a
# trailing-slash redirect and their index.html.
(static_site) {
	encode zstd gzip
	# Astro fingerprints everything under /_astro/; other files may change in place.
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "public, max-age=600"
	try_files {path} {path}.html
	file_server
}

(rate_limit_api) {
	rate_limit {
		zone api_ip {
			key {http.request.header.CF-Connecting-IP}
			events 300
			window 1m
		}
		zone api_total {
			key all
			events 3000
			window 1m
		}
	}
}

:80 {
	# Access log for every host, kept inside the caddy_data volume:
	#   docker exec caddy tail -f /data/access.log
	log {
		output file /data/access.log {
			roll_size 20MiB
			roll_keep 5
		}
		format json
	}

	# ============ PUBLIC SERVICES ============
	# status.elimelt.com → Uptime Kuma
	@status host status.elimelt.com
	handle @status {
		reverse_proxy uptime-kuma:3001
	}

	# api.elimelt.com → Public API
	@api host api.elimelt.com
	handle @api {
		import rate_limit_api
		@private_details {
			path /metrics /api/metrics /clicks/analytics /api/clicks/analytics /notes/sync/* /api/notes/sync/*
			method GET
		}
		respond @private_details "Forbidden" 403
		request_body {
			max_size 128KB
		}
		reverse_proxy public-api:80 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}

	# transcribe.elimelt.com → Speaches (Whisper transcription API)
	@transcribe host transcribe.elimelt.com
	handle @transcribe {
		request_body {
			max_size 25MB
		}
		# Rate limit: 10 requests per minute per verified client IP
		import rate_limit_transcribe

		# CORS for *.elimelt.com and localhost
		import cors_elimelt

		# Block management endpoints - model download/delete, process control, UI
		@blocked_models {
			path /v1/models/*
			not method GET
		}
		respond @blocked_models "Forbidden" 403

		@blocked_api_ps path /api/ps*
		respond @blocked_api_ps "Forbidden" 403

		@blocked_chat path /v1/chat/completions
		respond @blocked_chat "Forbidden" 403

		# Block Gradio UI (root path exactly)
		@blocked_ui path /
		respond @blocked_ui "Forbidden" 403

		reverse_proxy speaches:8000 {
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Methods
			header_down -Access-Control-Allow-Headers
			header_down -Access-Control-Allow-Credentials
		}
	}

	# llm.elimelt.com → Ollama (OpenAI-compatible LLM API)
	@llm host llm.elimelt.com
	handle @llm {
		request_body {
			max_size 128KB
		}
		# CORS for *.elimelt.com and localhost
		import cors_elimelt

		# Block model management endpoints
		@blocked path /api/pull /api/delete /api/copy /api/push /api/create
		handle @blocked {
			respond "Forbidden" 403
		}

		# All origins use the same rate limit; Origin is not authentication.
		handle {
			import rate_limit_llm
			reverse_proxy ollama:11434 {
				header_down -Access-Control-Allow-Origin
				header_down -Access-Control-Allow-Methods
				header_down -Access-Control-Allow-Headers
				header_down -Access-Control-Allow-Credentials
			}
		}
	}

	# ============ ADD NEW SERVICES HERE ============

	# inbox.elimelt.com → Inbox Agent frontend
	@inbox host inbox.elimelt.com
	handle @inbox {
		reverse_proxy inbox-agent:8000
	}

	# inbox-api.elimelt.com → Inbox Agent API
	@inbox_api host inbox-api.elimelt.com
	handle @inbox_api {
		import cors_elimelt
		reverse_proxy inbox-agent:8000
	}

	# static.elimelt.com → Static file server
	# Serves files from /static (tracked + untracked directories)
	@static host static.elimelt.com
	handle @static {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type"
		root * /static
		file_server browse
	}

	# ============ STATIC SITES ============
	# elimelt.com → Astro site (.github/workflows/web-deploy.yml)
	@web host elimelt.com
	handle @web {
		root * /srv/sites/web/current
		import static_site
	}

	@www host www.elimelt.com
	handle @www {
		redir https://elimelt.com{uri} permanent
	}

	# notes.elimelt.com → Quartz notes (.github/workflows/notes-deploy.yml)
	@notes host notes.elimelt.com
	handle @notes {
		root * /srv/sites/notes/current
		import static_site
	}

	# Quartz ships a styled 404 page; other hosts keep the plain response.
	handle_errors 404 {
		@notes_missing host notes.elimelt.com
		handle @notes_missing {
			root * /srv/sites/notes/current
			rewrite * /404.html
			file_server
		}
		handle {
			respond "Not Found" 404
		}
	}

	# Default: 404
	handle {
		respond "Not Found" 404
	}
}

# Cloudflare Tunnel
# Get token from: https://one.dash.cloudflare.com/ → Networks → Tunnels → Configure
CLOUDFLARE_TUNNEL_TOKEN=
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
# PostgreSQL
POSTGRES_USER=devuser
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=devdb

# Redis
REDIS_VERSION=7-alpine

# Public API
API_PATH=./api
API_CORS_ORIGINS=http://localhost:3000,https://elimelt.com

# AI Agents (optional)
AUGMENT_API_TOKEN=
GEMINI_API_KEY=
OPENAI_API_KEY=
ENABLE_CODEX_AGENT=1
CODEX_WORKDIR=/app
CODEX_SANDBOX_MODE=read-only
CODEX_HOME=/home/elimelt/.codex

# Notes Sync (optional)
GITHUB_TOKEN=
NOTES_SYNC_SECRET=

# System
TZ=America/Los_Angeles
COMPOSE_PROJECT_NAME=homelab

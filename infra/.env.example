# Cloudflare Tunnel
# Get token from: https://one.dash.cloudflare.com/ → Networks → Tunnels → Configure
CLOUDFLARE_TUNNEL_TOKEN=
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
# PostgreSQL
POSTGRES_USER=devuser
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=devdb

# Redis
REDIS_VERSION=7-alpine

# Public API
API_PATH=./api
API_CORS_ORIGINS=http://localhost:3000,https://elimelt.com

# AI Agents (optional)
AUGMENT_API_TOKEN=
GEMINI_API_KEY=
OPENAI_API_KEY=
ENABLE_CODEX_AGENT=1
# Optional alternative to an API key: a dedicated host directory containing only a ChatGPT
# Codex auth.json (mkdir -p ~/.codex-api && install -m 600 ~/.codex/auth.json ~/.codex-api/auth.json).
# The container starts without it; Codex is then reported unavailable.
# Public chat runs without command execution, plugins, or host workspace access.
#CODEX_AUTH_DIR=/home/elimelt/.codex-api
CODEX_AGENT_MODEL=gpt-6-sol
CODEX_AGENT_COUNT=2
CODEX_WORKDIR=/app
CODEX_SANDBOX_MODE=read-only

# Notes Sync (optional)
GITHUB_TOKEN=
NOTES_SYNC_SECRET=
# Secret key for pseudonymous visitor ids (e.g. `openssl rand -hex 32`). If unset, a random per-process key is used and ids change on restart.
VISITOR_ID_SECRET=
INSTALL_EMBEDDINGS=0

# System
TZ=America/Los_Angeles
COMPOSE_PROJECT_NAME=homelab

# Private broker token; generate with: openssl rand -hex 32
SANDBOX_WORKER_TOKEN=

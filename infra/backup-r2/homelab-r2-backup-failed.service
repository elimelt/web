[Unit]
Description=Report failed homelab backup on the desktop

[Service]
Type=oneshot
User=elimelt
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/usr/bin/notify-send --urgency=critical "Homelab backup failed" "Check sudo journalctl -u homelab-r2-backup -u homelab-r2-maintain and /var/lib/homelab-backup/last-failure.json"
